<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/filaJugador"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageButton
        android:id="@+id/btnColorJugador"
        android:layout_width="34dp"
        android:layout_height="38dp"
        android:layout_marginEnd="5dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Cambiar color del participante"
        android:src="@drawable/ic_settings"
        app:tint="@color/gold" />

    <TextView
        android:id="@+id/txtNombreJugador"
        android:layout_width="77dp"
        android:layout_height="wrap_content"
        android:text="Jugador 1:"
        android:textColor="@android:color/white"
        android:textSize="13sp"
        android:textStyle="bold" />

    <Spinner
        android:id="@+id/spnJugador"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_weight="1"
        android:background="@drawable/fondo_spinner_jugador"
        android:popupBackground="@drawable/fondo_popup_spinner_jugador"
        android:spinnerMode="dropdown"
        android:contentDescription="Seleccionar jugador" />

    <TextView
        android:id="@+id/btnEliminarJugador"
        android:layout_width="32dp"
        android:layout_height="44dp"
        android:gravity="center"
        android:text="✕"
        android:contentDescription="Quitar participante"
        android:textColor="@color/gold"
        android:textSize="19sp"
        android:textStyle="bold" />

</LinearLayout>
