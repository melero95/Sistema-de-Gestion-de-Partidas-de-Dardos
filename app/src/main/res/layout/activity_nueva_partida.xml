<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainNuevaPartida"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondo"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    tools:context="activities.ConfigurarNuevaPartidaActivity">

    <TextView
        android:id="@+id/txtTituloNuevaPartida"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/nueva_partida"
        android:textColor="@color/gold"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/txtSubtituloNuevaPartida"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:gravity="center"
        android:text="@string/nueva_partida_elige_el_modo_los_jugadores_y_las_opciones_de_la_par"
        android:textColor="@android:color/white"
        android:textSize="15sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtTituloNuevaPartida" />

    <ScrollView
        android:id="@+id/scrollOpcionesPartida"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="9dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="2dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtSubtituloNuevaPartida"
        app:layout_constraintBottom_toTopOf="@id/btnCrearPartida">

        <LinearLayout
            android:id="@+id/contenedorOpcionesPartida"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- TARJETA 1: CONFIGURACION GENERAL -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardConfiguracionPartida"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="9dp"
                app:cardBackgroundColor="#CC1A237E"
                app:cardCornerRadius="14dp"
                app:cardElevation="5dp"
                app:strokeColor="@color/gold"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/nueva_partida_configuracion_de_partida"
                        android:textColor="@color/gold"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/TituloSeccionAjustes"
                        android:layout_marginTop="9dp"
                        android:text="@string/nueva_partida_modo_de_juego" />

                    <Spinner
            style="@style/SpinnerDardos"
                        android:id="@+id/spnModoJuego"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="3dp" />

                    <TextView
                        style="@style/TituloSeccionAjustes"
                        android:layout_marginTop="5dp"
                        android:text="@string/nueva_partida_maximo_de_rondas" />

                    <LinearLayout
                        android:id="@+id/contenedorRondas"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btnRestarRonda"
                            android:layout_width="48dp"
                            android:layout_height="match_parent"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="@string/simbolo_menos"
                            android:textColor="@color/gold"
                            android:textSize="26sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtMaxRondas"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="@string/valor_15"
                            android:textColor="@android:color/white"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btnSumarRonda"
                            android:layout_width="48dp"
                            android:layout_height="match_parent"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="@string/simbolo_mas"
                            android:textColor="@color/gold"
                            android:textSize="24sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- TARJETA 2: SOLO PARTICIPANTES Y GESTION DE JUGADORES -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardJugadores"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="9dp"
                app:cardBackgroundColor="#CC1A237E"
                app:cardCornerRadius="14dp"
                app:cardElevation="5dp"
                app:strokeColor="@color/gold"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/txtTituloJugadores"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/comun_jugadores"
                        android:textColor="@color/gold"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/nueva_partida_pulsa_el_nombre_para_elegir_un_jugador_activo"
                        android:textColor="@android:color/white"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/txtAvisoSinJugadores"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/texto_activity_nueva_partida_6f1bb6c"
                        android:textColor="@android:color/white"
                        android:textSize="14sp"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/contenedorJugadores"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:orientation="vertical" />

                    <Button
                        android:id="@+id/btnAnadirJugador"
                        style="@style/BotonPrincipal"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="5dp"
                        android:text="@string/nueva_partida_anadir_participante"
                        android:textAllCaps="false"
                        android:textSize="16sp" />

                    <Button
                        android:id="@+id/btnGestionarJugadores"
                        style="@style/BotonPrincipal"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="6dp"
                        android:text="@string/nueva_partida_gestionar_jugadores"
                        android:textAllCaps="false"
                        android:textSize="15sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- TARJETA 3: ULTIMA CONFIGURACION Y AJUSTES AVANZADOS -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardOpcionesAdicionales"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="9dp"
                app:cardBackgroundColor="#CC1A237E"
                app:cardCornerRadius="14dp"
                app:cardElevation="5dp"
                app:strokeColor="@color/gold"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/nueva_partida_opciones_adicionales"
                        android:textColor="@color/gold"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnUltimaConfiguracion"
                        style="@style/BotonPrincipal"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="5dp"
                        android:text="@string/nueva_partida_usar_ultima_configuracion"
                        android:textAllCaps="false"
                        android:textSize="15sp" />

                    <Button
                        android:id="@+id/btnMostrarAjustesAvanzados"
                        style="@style/BotonPrincipal"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="6dp"
                        android:text="@string/nueva_partida_mas_ajustes"
                        android:textAllCaps="false"
                        android:textSize="15sp" />

                    <LinearLayout
                        android:id="@+id/contenedorAjustesAvanzados"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:background="#3310174F"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:visibility="gone">

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switchCierreDoble"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:thumbTint="@color/switch_thumb_color"
                            app:trackTint="@color/switch_track_color"
                            android:text="@string/nueva_partida_cerrar_la_partida_con_un_doble"
                            android:textColor="@android:color/white" />

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switchMantenerMultiplicador"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            app:thumbTint="@color/switch_thumb_color"
                            app:trackTint="@color/switch_track_color"
                            android:text="@string/nueva_partida_mantener_multiplicador_tras_cada_dardo"
                            android:textColor="@android:color/white" />

                        <TextView
                            android:id="@+id/txtTituloNumeroDardos"
                            style="@style/TituloSeccionAjustes"
                            android:layout_marginTop="5dp"
                            android:text="@string/comun_dardos_por_turno" />

                        <Spinner
            style="@style/SpinnerDardos"
                            android:id="@+id/spnNumeroDardos"
                            android:layout_width="match_parent"
                            android:layout_height="44dp" />

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switchOrdenAleatorio"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            app:thumbTint="@color/switch_thumb_color"
                            app:trackTint="@color/switch_track_color"
                            android:text="@string/comun_orden_de_jugadores_aleatorio"
                            android:textColor="@android:color/white" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btnCrearPartida"
        style="@style/BotonPrincipal"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginEnd="6dp"
        android:layout_marginBottom="28dp"
        android:text="@string/nueva_partida_crear_partida"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnCancelarPartida"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/btnCancelarPartida"
        style="@style/BotonPrincipal"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginStart="6dp"
        android:layout_marginBottom="28dp"
        android:text="@string/nueva_partida_cancelar"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/btnCrearPartida" />
</androidx.constraintlayout.widget.ConstraintLayout>
