<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/fondo" android:paddingStart="16dp" android:paddingEnd="16dp">
    <TextView android:id="@+id/txtTituloDetalle" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_marginTop="28dp" android:gravity="center"
        android:text="Detalle de partida" android:textColor="@color/gold"
        android:textSize="26sp" android:textStyle="bold" app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
    <com.google.android.material.card.MaterialCardView android:id="@+id/cardDetalleCabecera"
        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="12dp"
        app:cardBackgroundColor="#CC1A237E" app:strokeColor="@color/gold" app:strokeWidth="1dp"
        app:cardCornerRadius="12dp" app:layout_constraintTop_toBottomOf="@id/txtTituloDetalle"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:padding="14dp" android:orientation="vertical">
            <TextView android:id="@+id/txtModoDetalle" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center" android:textColor="@color/gold" android:textSize="22sp" android:textStyle="bold" />
            <TextView android:id="@+id/txtResumenDetalle" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="5dp" android:gravity="center" android:textColor="@android:color/white" android:textSize="14sp" />
            <TextView android:id="@+id/txtFechaDetalle" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="5dp" android:gravity="center"
                android:textColor="@android:color/white" android:textSize="13sp" />
            <TextView android:id="@+id/txtMotivoDetalle" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="5dp" android:gravity="center" android:textColor="@android:color/white" android:textSize="13sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.card.MaterialCardView android:layout_width="0dp" android:layout_height="0dp"
        android:layout_marginTop="12dp" android:layout_marginBottom="12dp"
        app:cardBackgroundColor="#CC1A237E" app:strokeColor="@color/gold" app:strokeWidth="1dp"
        app:cardCornerRadius="12dp" app:layout_constraintTop_toBottomOf="@id/cardDetalleCabecera"
        app:layout_constraintBottom_toTopOf="@id/btnRepetirDetalle"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerResultadosHistoricos"
            android:layout_width="match_parent" android:layout_height="match_parent" android:padding="8dp" />
    </com.google.android.material.card.MaterialCardView>
    <Button android:id="@+id/btnRepetirDetalle" android:layout_width="0dp" android:layout_height="46dp"
        android:text="Repetir partida" android:textAllCaps="false" android:backgroundTint="@color/gold"
        android:textColor="@color/blue" app:layout_constraintBottom_toTopOf="@id/btnEditarDetalle"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
    <Button android:id="@+id/btnEditarDetalle" android:layout_width="0dp"
        android:layout_height="46dp"
        android:layout_marginTop="5dp"
        android:text="Reutilizar configuración"
        android:textAllCaps="false"
        android:backgroundTint="@color/gold"
        android:textColor="@color/blue"
        app:layout_constraintBottom_toTopOf="@id/btnVolverDetalle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    <Button android:id="@+id/btnVolverDetalle" android:layout_width="0dp" android:layout_height="46dp"
        android:layout_marginTop="5dp" android:layout_marginBottom="28dp"
        android:text="Volver al historial" android:textAllCaps="false"
        android:backgroundTint="@color/gold" android:textColor="@color/blue"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
